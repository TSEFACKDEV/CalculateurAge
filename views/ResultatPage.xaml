<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.ResultatPage"
             Title="Résultat">
    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="{Binding Message}" FontSize="22"/>
        <Label Text="{Binding Categorie}" FontSize="18"/>
        <Label Text="{Binding JoursRestants, StringFormat='Jours restants : {0}'}" FontSize="16"/>
        <Button Text="Retour" Clicked="OnRetourClicked"/>
    </VerticalStackLayout>
</ContentPage>